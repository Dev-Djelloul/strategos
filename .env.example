# Identifiants ACLED (https://acleddata.com/myacled) - inscription gratuite
# pour usage non-commercial/académique. Copie ce fichier en .env et
# renseigne tes vrais identifiants. .env est ignoré par git (.gitignore) -
# ne jamais committer de vrais identifiants.
ACLED_EMAIL=ton-email@example.com
ACLED_PASSWORD=ton-mot-de-passe

# Token Cesium Ion (https://ion.cesium.com/signup) - inscription gratuite,
# palier gratuit généreux. Optionnel : sans lui, le globe reste plat
# (ellipsoïde) au lieu d'afficher le relief (montagnes, vallées).
CESIUM_ION_TOKEN=
