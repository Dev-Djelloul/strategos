{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strategos",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // Le Worker traite l'API et les pages générées ; tout le reste (page du
    // globe, JS, CSS) est servi directement depuis les assets statiques.
    "run_worker_first": ["/api/*", "/methodologie", "/config.js"]
  },
  "kv_namespaces": [
    // Créer avec : wrangler kv namespace create CACHE  (puis coller l'id ici)
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "triggers": {
    // Toutes les 15 min : collecte GDELT + préchauffage des couches lentes.
    "crons": ["*/15 * * * *"]
  }
}
